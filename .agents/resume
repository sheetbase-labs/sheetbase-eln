#!/usr/bin/env bash
# .agents/resume — fast, idempotent; runs when an existing orb wakes from pause.
# Reconnect/repair only; never install. Must finish within ~10 seconds.
set -euo pipefail

# Start the local PostgreSQL 18 cluster if it is not already online.
if command -v pg_lsclusters >/dev/null 2>&1; then
  if ! pg_lsclusters --no-header 2>/dev/null | awk '$1=="18"&&$2=="main"&&$4=="online"{f=1}END{exit !f}'; then
    sudo pg_ctlcluster 18 main start 2>/dev/null || true
  fi
fi

echo "resume: postgres is $(sudo -u postgres pg_isready 2>&1 || echo 'not ready')"

# Restart PostgREST if the binary exists and the service is not already running.
# orb services are killed on pause; they need to be restarted on resume.
if command -v postgrest >/dev/null 2>&1; then
  if ! amp orb service status postgrest >/dev/null 2>&1; then
    amp orb service start postgrest --command './scripts/postgrest.sh' 2>/dev/null || true
  fi
  echo "resume: postgrest $(curl -sf http://127.0.0.1:3002/ready >/dev/null 2>&1 && echo 'ready' || echo 'not ready')"
fi
