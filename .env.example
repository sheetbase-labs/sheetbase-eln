# Application database connection (from the host; used by the app and seed
# scripts).
DATABASE_URL=postgresql://sheetbase:sheetbase@localhost:5432/sheetbase

# REL-001 deployment identity. Local development uses these harmless defaults.
# Staging and production use a secret manager. Their artifact version and
# expected migration are baked into the immutable image; the deploy command
# derives its digest from the selected image reference. See docs/deployment.md.
SHEETBASE_ENV=development
SHEETBASE_SECRET_SOURCE=local-env
SHEETBASE_ARTIFACT_VERSION=local
SHEETBASE_ARTIFACT_DIGEST=untracked
SHEETBASE_EXPECTED_MIGRATION=untracked

# Auth-free review mode is only for the disposable development environment.
# Leave false locally unless you intentionally want the seeded fixture user
# to be used without a Better Auth cookie. Deployment validation rejects true
# in staging and production.
SHEETBASE_DEV_AUTH_FREE=false
SHEETBASE_DEV_USER_ID=00000000-0000-4000-8000-000000000001

# Migration connection (from the host; used by drizzle-kit generate/migrate).
# DDL runs as the dedicated migrator role, not the superuser.
MIGRATION_DATABASE_URL=postgresql://migrator:migrator-dev-password@localhost:5432/sheetbase

# Dedicated server-only formula writer connection. This LOGIN can assume only
# the narrow formula_writer capability role; it has no direct data-table rights.
FORMULA_DATABASE_URL=postgresql://formula_runtime:formula-dev-password@localhost:5432/sheetbase

# PostgreSQL service (compose). Dev defaults only — set your own values for
# anything beyond local development.
POSTGRES_DB=sheetbase
POSTGRES_USER=sheetbase
POSTGRES_PASSWORD=sheetbase
POSTGRES_PORT=5432

# Better Auth. Dev-only secret (32+ characters); replace for any shared
# environment.
BETTER_AUTH_SECRET=dev-only-insecure-auth-secret-replace-me-0123456789
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth (see docs/authentication.md for the OAuth app setup). Leave
# unset to run the app with sign-in disabled until configured.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sheetbase currently qualifies for Handsontable's non-commercial/evaluation
# mode. Handsontable validates this public build configuration in the browser.
VITE_HANDSONTABLE_LICENSE_KEY=non-commercial-and-evaluation

# PostgREST service (compose). PGRST_DB_URI points at the compose-internal
# hostname "postgres"; its password must match POSTGREST_AUTHENTICATOR_PASSWORD,
# which docker/db/init/00-roles.sh uses to create the authenticator role on
# first volume initialisation.
POSTGREST_AUTHENTICATOR_PASSWORD=postgrest-dev-password
MIGRATOR_PASSWORD=migrator-dev-password
FORMULA_WRITER_PASSWORD=formula-dev-password
PGRST_DB_URI=postgresql://authenticator:postgrest-dev-password@postgres:5432/sheetbase
# Dev-only JWT secret (PostgREST requires 32+ characters). Server-side only —
# never exposed to the browser. Replace for any shared environment.
PGRST_JWT_SECRET=dev-only-insecure-jwt-secret-replace-me-0123456789abcdef
# Server-only upstream for the same-origin data proxy (/api/db/*).
POSTGREST_URL=http://localhost:3001
POSTGREST_PORT=3001
POSTGREST_ADMIN_PORT=3002
POSTGREST_ADMIN_URL=http://localhost:3002

# SCI-003 object-storage boundary (decision 0028). The local backend is the
# default and needs no cloud credentials — it stores bytes on the local
# filesystem under FILE_STORAGE_DIR (gitignored). Set FILE_STORAGE_BACKEND=s3
# and provide S3_* credentials for production. The storage key is
# backend-independent.
FILE_STORAGE_BACKEND=local
FILE_STORAGE_DIR=./.storage/objects
