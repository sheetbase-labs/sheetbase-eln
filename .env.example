# Application database connection (from the host; used by the app and seed
# scripts).
DATABASE_URL=postgresql://sheetbase:sheetbase@localhost:5432/sheetbase

# REL-001 deployment identity. Local development uses these harmless defaults.
# Staging and production use a secret manager. Their artifact version and
# expected migration are baked into the immutable image; the deploy command
# derives its digest from the selected image reference. See docs/operations/deployment.md.
SHEETBASE_ENV=development
SHEETBASE_SECRET_SOURCE=local-env
SHEETBASE_ARTIFACT_VERSION=local
SHEETBASE_ARTIFACT_DIGEST=untracked
SHEETBASE_EXPECTED_MIGRATION=untracked

# Auth-free review mode is only for the disposable development environment.
# Leave false locally unless you intentionally want the seeded fixture user
# to be used without a Better Auth cookie. Deployment validation rejects true
# in staging and production. The seed runner uses this same ID for the
# auth-free user and its fixture-workspace membership.
SHEETBASE_DEV_AUTH_FREE=false
SHEETBASE_DEV_USER_ID=00000000-0000-4000-8000-000000000001

# Optional capability flags: a comma-separated allow-list of the capabilities
# this deployment does not have. Nothing is registered today — every audited
# gap is a shipped feature — so leaving this unset (or naming anything) gates
# nothing. A capability is a deployment input, never a permission: PostgreSQL
# RLS and api.has_capability stay authoritative.
#SHEETBASE_CAPABILITIES=

# Migration connection (from the host; used by drizzle-kit generate/migrate).
# DDL runs as the dedicated migrator role, not the superuser.
MIGRATION_DATABASE_URL=postgresql://migrator:migrator-dev-password@localhost:5432/sheetbase

# Dedicated server-only formula writer connection. This LOGIN can assume only
# the narrow formula_writer capability role; it has no direct data-table rights.
FORMULA_DATABASE_URL=postgresql://formula_runtime:formula-dev-password@localhost:5432/sheetbase

# Pipeline SQL sandbox. Untrusted transform SQL runs on its own connection as
# this LOGIN role, which has no table or schema grants and is a member of no
# other role, so there is no role to reset back to. Never point it at DATABASE_URL.
PIPELINE_SANDBOX_DATABASE_URL=postgresql://pipeline_sandbox:pipeline-sandbox-dev-password@localhost:5432/sheetbase

# PostgreSQL service (compose). Dev defaults only — set your own values for
# anything beyond local development.
POSTGRES_DB=sheetbase
POSTGRES_USER=sheetbase
POSTGRES_PASSWORD=sheetbase
POSTGRES_PORT=5432

# Better Auth. Dev-only secret (32+ characters); replace for any shared
# environment.
BETTER_AUTH_SECRET=dev-only-insecure-auth-secret-replace-me-0123456789
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth (see docs/operations/authentication.md for the OAuth app setup). Leave
# unset to run the app with sign-in disabled until configured.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# PostgREST service (compose). PGRST_DB_URI points at the compose-internal
# hostname "postgres"; its password must match POSTGREST_AUTHENTICATOR_PASSWORD,
# which docker/db/init/00-roles.sh uses to create the authenticator role on
# first volume initialisation.
POSTGREST_AUTHENTICATOR_PASSWORD=postgrest-dev-password
MIGRATOR_PASSWORD=migrator-dev-password
FORMULA_WRITER_PASSWORD=formula-dev-password
PIPELINE_SANDBOX_PASSWORD=pipeline-sandbox-dev-password
PGRST_DB_URI=postgresql://authenticator:postgrest-dev-password@postgres:5432/sheetbase
# Dev-only JWT secret (PostgREST requires 32+ characters). Server-side only —
# never exposed to the browser. Replace for any shared environment.
PGRST_JWT_SECRET=dev-only-insecure-jwt-secret-replace-me-0123456789abcdef
# Server-only upstream for the same-origin data proxy (/api/db/*).
POSTGREST_URL=http://localhost:3001
POSTGREST_PORT=3001
POSTGREST_ADMIN_PORT=3002
POSTGREST_ADMIN_URL=http://localhost:3002

# SCI-003 object-storage boundary (decision 0028). The local backend is the
# default and needs no cloud credentials — it stores bytes on the local
# filesystem under FILE_STORAGE_DIR (gitignored). Set FILE_STORAGE_BACKEND=s3
# and provide S3_* credentials for production. The storage key is
# backend-independent.
FILE_STORAGE_BACKEND=local
FILE_STORAGE_DIR=./.storage/objects

# INT-03 connector destination policy. Connector destinations are untrusted
# configuration: endpoint URLs must be http(s), credential-bearing URLs and
# file:// are always refused. Private/on-prem addresses are allowed by default
# (Sheetbase legitimately integrates with on-prem networks) — this is
# application policy only, never network isolation.
# CONNECTOR_ALLOW_PRIVATE_HOSTS=false refuses loopback/private destinations.
# CONNECTOR_HOST_ALLOWLIST optionally restricts every connector destination to
# a comma-separated list of hostnames / *.wildcards. Unset = no allowlist.
#CONNECTOR_ALLOW_PRIVATE_HOSTS=true
#CONNECTOR_HOST_ALLOWLIST=

# PLAT-02 observability. /api/metrics serves Prometheus-format metrics.
# Optional in development (open on localhost); in staging/production the
# endpoint fails closed (404) unless this 32+ char bearer token is set and
# supplied. Inject from the secret manager; never commit a real value.
#SHEETBASE_METRICS_TOKEN=

# PLAT-03 API abuse bound for the data proxy and file byte routes: requests
# per window per authenticated principal. Credential exchange has its own
# per-credential limiter. The limiter fails open; these bounds are deliberate,
# not an availability control.
#SHEETBASE_RATE_LIMIT_MAX=600
#SHEETBASE_RATE_LIMIT_WINDOW_SECONDS=60

# R5-CONFIG-01 optional workspace plan limits. Configuration, not a hard-coded
# number in the UI. Unset = no limit configured, and the Usage screen says so
# instead of inventing a threshold. When set, the matching meter shows the limit
# with ≥80% warning / ≥90% danger states.
#SHEETBASE_WORKSPACE_STORAGE_QUOTA_BYTES=
#SHEETBASE_WORKSPACE_SEAT_LIMIT=

# Optional isolated Python runner. See docs/operations/pipeline-python.md.
# Keep the matching bearer token server-only. SQL and ELN actions work without it.
#PIPELINE_PYTHON_RUNNER_URL=http://127.0.0.1:3003
#PIPELINE_PYTHON_RUNNER_TOKEN=

# Company single sign-on over OpenID Connect (docs/operations/authentication.md).
# Set all three to show a "Continue with <name>" button on the sign-in screen.
#OIDC_ISSUER_URL=https://login.example.com/realms/lab
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_PROVIDER_NAME="Company SSO"

# Email sign-in by one-time link. Needs SMTP_HOST below. Existing accounts can
# always use it; new accounts only from the listed domains.
#EMAIL_LOGIN_ENABLED=true
#EMAIL_LOGIN_ALLOWED_DOMAINS=example.com

# AI provider profiles (docs/operations/ai.md). Non-secret JSON: every profile
# names the server environment variable holding its key. Unset means no
# external provider is configured and the assistant uses the built-in
# deterministic model, which makes no network call. The example is inert.
# See the schema and examples in docs/operations/ai.md before setting this.
#AI_PROVIDER_PROFILES='{"profiles":[{"id":"local-ollama","label":"Local Ollama","kind":"local","baseUrl":"http://127.0.0.1:11434/v1","model":"llama3.1:8b","pricing":{"inputMicrousdPerMillionTokens":0,"outputMicrousdPerMillionTokens":0}}]}'
#OPENROUTER_API_KEY=
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# Email (WORK-03.4). Leave SMTP_HOST empty to disable email delivery; the
# outbox still records pending deliveries. Requires the optional `nodemailer`
# dependency when enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sheetbase <no-reply@sheetbase.local>"
