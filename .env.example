# Application database connection (from the host; used by the app, Drizzle
# migrations and seed scripts).
DATABASE_URL=postgresql://sheetbase:sheetbase@localhost:5432/sheetbase

# PostgreSQL service (compose). Dev defaults only — set your own values for
# anything beyond local development.
POSTGRES_DB=sheetbase
POSTGRES_USER=sheetbase
POSTGRES_PASSWORD=sheetbase
POSTGRES_PORT=5432

# PostgREST service (compose). PGRST_DB_URI points at the compose-internal
# hostname "postgres"; its password must match POSTGREST_AUTHENTICATOR_PASSWORD,
# which docker/db/init/00-roles.sh uses to create the authenticator role on
# first volume initialisation.
POSTGREST_AUTHENTICATOR_PASSWORD=postgrest-dev-password
PGRST_DB_URI=postgresql://authenticator:postgrest-dev-password@postgres:5432/sheetbase
# Dev-only JWT secret (PostgREST requires 32+ characters). Server-side only —
# never exposed to the browser. Replace for any shared environment.
PGRST_JWT_SECRET=dev-only-insecure-jwt-secret-replace-me-0123456789abcdef
POSTGREST_PORT=3001
POSTGREST_ADMIN_PORT=3002
