# Private component packages (@sheetbase-labs) come from GitHub Packages.
# The token is NOT configured here: pnpm refuses to expand environment
# variables in a committed .npmrc. Put the credential in a trusted source
# instead — CI writes `//npm.pkg.github.com/:_authToken=${{ secrets.GITHUB_TOKEN }}`
# to ~/.npmrc (packages: read), and locally use `pnpm config set`.
@sheetbase-labs:registry=https://npm.pkg.github.com
