# syntax=docker/dockerfile:1.7
# Railway build. The private @sheetbase-labs packages are published to GitHub
# Packages, which needs a token even for public repositories, so this image
# builds them from the public sheetbase-components repository instead and links
# them in (scripts/railway-link-components.mjs). The default Dockerfile stays
# the release image.
#
# Railway passes service variables as build arguments. SHEETBASE_ENV and
# SHEETBASE_NOW are baked into the client bundle, so set them on the service
# before building. The container backs up, applies migrations, then serves (scripts/upgrade.ts).
ARG COMPONENTS_REF=main

FROM oven/bun:1 AS components
ARG COMPONENTS_REF
# ADD resolves the ref on every build and caches by commit. A RUN git clone is
# cached by its command text, so a new components release was never fetched.
ADD https://github.com/sheetbase-labs/sheetbase-components.git#${COMPONENTS_REF} /sheetbase-components
WORKDIR /sheetbase-components
RUN bun install --frozen-lockfile && bun run build:lib

FROM node:26-bookworm-slim
WORKDIR /app
RUN npm install --global pnpm@11.9.0
COPY --from=components /sheetbase-components /sheetbase-components
COPY . .
RUN node scripts/railway-link-components.mjs /sheetbase-components/packages \
    && pnpm install --frozen-lockfile --ignore-scripts

ARG SHEETBASE_ENV
ARG SHEETBASE_NOW
RUN SHEETBASE_ENV=${SHEETBASE_ENV} SHEETBASE_NOW=${SHEETBASE_NOW} \
    DATABASE_URL=postgresql://build:build@database.invalid/sheetbase \
    FORMULA_DATABASE_URL=postgresql://build:build@database.invalid/sheetbase \
    BETTER_AUTH_SECRET=build-only-placeholder-at-least-32-characters \
    PGRST_JWT_SECRET=build-only-placeholder-at-least-32-characters \
    NODE_OPTIONS=--max-old-space-size=8192 \
    node_modules/.bin/vite build

ENV NODE_ENV=production PORT=3000
RUN mkdir -p /app/.storage/objects && chown -R node:node /app
USER node
EXPOSE 3000
CMD ["sh", "-c", "node --import tsx scripts/upgrade.ts && (node scripts/stage-demo-files.mjs || echo demo file staging failed) && node scripts/serve-production.mjs"]
