{
  "name": "sheetbase",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:phase1": "vitest run --config vitest.db.config.ts phase1-proof",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed/run.ts",
    "db:seed:demo": "tsx src/db/seed/run.ts --demo",
    "db:reset": "tsx src/db/reset.ts",
    "db:fresh": "tsx src/db/fresh.ts",
    "services:up": "docker compose --env-file .env.local up -d --build",
    "services:down": "docker compose --env-file .env.local down",
    "services:ps": "docker compose --env-file .env.local ps",
    "services:logs": "docker compose --env-file .env.local logs -f",
    "services:recreate": "docker compose --env-file .env.local up -d --build --force-recreate",
    "services:purge": "docker compose --env-file .env.local down -v",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src vite.config.ts vitest.config.ts drizzle.config.ts",
    "format": "prettier --write src docs package.json components.json tsconfig.json tsr.config.json vite.config.ts vitest.config.ts drizzle.config.ts eslint.config.js prettier.config.js pnpm-workspace.yaml compose.yaml README.md && eslint --fix src vite.config.ts vitest.config.ts drizzle.config.ts",
    "check": "prettier --check src docs package.json components.json tsconfig.json tsr.config.json vite.config.ts vitest.config.ts drizzle.config.ts eslint.config.js prettier.config.js pnpm-workspace.yaml compose.yaml README.md"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/query-db-collection": "^1.1.0",
    "@tanstack/react-db": "^0.1.94",
    "@tanstack/react-devtools": "^0.10.8",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.30",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.168.22",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "lucide-react": "^0.577.0",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.8.1",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.167.21",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
