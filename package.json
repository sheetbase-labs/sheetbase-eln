{
  "name": "sheetbase",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "node scripts/generate-routes.mjs",
    "openapi:generate": "tsx scripts/generate-public-openapi.ts && prettier --write docs/api/openapi/external-api-v0.json",
    "build": "vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "start": "node scripts/start-prod.mjs",
    "artifact:build": "node --import tsx scripts/build-artifact.ts",
    "deploy:plan": "node --import tsx scripts/deploy.ts --plan",
    "deploy:apply": "node --import tsx scripts/deploy.ts --apply",
    "audit:verify": "node --import tsx scripts/audit-verification.ts",
    "backup:run": "node --import tsx scripts/backup.ts",
    "backup:restore-drill": "node --import tsx scripts/restore-drill.ts",
    "storage:copy": "node --import tsx scripts/storage-copy.ts",
    "workspace:restore": "node --import tsx scripts/workspace-restore.ts",
    "release:local": "bash scripts/release.sh",
    "preview": "vite preview",
    "test": "vitest run",
    "design:render": "tsx scripts/design-reference.mts",
    "perf:seed": "tsx perf/fixtures.ts",
    "perf:db": "tsx perf/dataset.ts",
    "perf:pipelines": "tsx perf/pipelines.ts",
    "perf:http": "tsx perf/http.ts",
    "perf:files": "tsx perf/files.ts",
    "perf:connectors": "tsx perf/connectors.ts",
    "perf:sheet-notebook": "tsx perf/sheet-notebook.ts",
    "perf:pressure": "tsx perf/pressure.ts",
    "perf:all": "tsx perf/run.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:browser": "playwright test --project=browser --workers=2",
    "test:parity": "tsx scripts/design-reference.mts --if-stale && playwright test --project=parity --workers=8 --reporter=list,./tests/visual/parity-reporter.ts",
    "test:phase1": "vitest run --config vitest.db.config.ts phase1-proof",
    "test:phase3": "vitest run --config vitest.db.config.ts phase3-proof",
    "test:phase4": "vitest run src/lib/formula-ir.test.ts src/lib/scientific-workbook-engine.test.ts src/lib/calculation.server.test.ts src/lib/formula-write.server.test.ts src/lib/function-descriptions.test.ts src/lib/sheet-calculation.test.ts src/lib/sheet-calculation-exclusion.test.ts src/components/notebook/scientific-workbook-provider.test.tsx && playwright test phase4-proof",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build-storybook",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-once.mjs",
    "db:upgrade": "node --import tsx scripts/upgrade.ts",
    "db:seed": "tsx src/db/seed/run.ts",
    "db:seed:demo": "tsx src/db/seed/run.ts --demo",
    "db:seed:design": "tsx src/db/seed/run.ts --design",
    "db:seed:month": "tsx src/db/seed/run.ts --month",
    "db:reset": "tsx src/db/reset.ts",
    "db:fresh": "tsx src/db/fresh.ts",
    "services:up": "docker compose --env-file .env.local up -d --build",
    "services:down": "docker compose --env-file .env.local down",
    "services:ps": "docker compose --env-file .env.local ps",
    "services:logs": "docker compose --env-file .env.local logs -f",
    "services:recreate": "docker compose --env-file .env.local up -d --build --force-recreate",
    "services:purge": "docker compose --env-file .env.local down -v",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src scripts perf vite.config.ts vitest.config.ts drizzle.config.ts",
    "format": "prettier --write src scripts docs package.json components.json tsconfig.json tsr.config.json vite.config.ts vitest.config.ts drizzle.config.ts eslint.config.js prettier.config.js pnpm-workspace.yaml compose.yaml compose.deploy.yaml compose.dev.yaml README.md && eslint --fix src scripts vite.config.ts vitest.config.ts drizzle.config.ts",
    "check": "prettier --check src scripts docs package.json components.json tsconfig.json tsr.config.json vite.config.ts vitest.config.ts drizzle.config.ts eslint.config.js prettier.config.js pnpm-workspace.yaml compose.yaml compose.deploy.yaml compose.dev.yaml README.md && tsx scripts/check-colours.mts && tsx scripts/check-copy.mts",
    "check:colours": "tsx scripts/check-colours.mts",
    "check:copy": "tsx scripts/check-copy.mts",
    "design:coverage": "tsx scripts/design-seed-coverage.mts",
    "test:crawl": "node tests/browser-scripts/crawl.mjs",
    "test:screens": "node tests/browser-scripts/screens.mjs",
    "test:phone": "node tests/browser-scripts/phone.mjs",
    "test:areas": "for f in tests/browser-scripts/areas/*.mjs; do node $f || exit 1; done",
    "test:interactions": "node tests/browser-scripts/interactions.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@base-ui/react": "^1.8.0",
    "@dagrejs/dagre": "^3.0.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@liveblocks/client": "^3.24.1",
    "@liveblocks/node": "^3.24.1",
    "@liveblocks/react": "^3.24.1",
    "@liveblocks/react-ui": "^3.24.1",
    "@sheetbase-labs/sheetbase-advanced-search": "0.6.0",
    "@sheetbase-labs/sheetbase-explorer": "0.6.0",
    "@sheetbase-labs/sheetbase-shared": "0.6.0",
    "@sheetbase-labs/sheetbase-table": "0.6.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/query-db-collection": "^1.1.0",
    "@tanstack/react-db": "^0.1.94",
    "@tanstack/react-devtools": "^0.10.8",
    "@tanstack/react-query": "^5.102.0",
    "@tanstack/react-query-devtools": "^5.102.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.10",
    "@tanstack/router-plugin": "^1.168.48",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-subscript": "^3.30.5",
    "@tiptap/extension-superscript": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@xyflow/react": "^12.11.2",
    "apache-arrow": "^21.2.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "jose": "^6.2.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.577.0",
    "marked": "^18.0.11",
    "nodemailer": "^10.1.4",
    "parquet-wasm": "^0.7.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.2",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "unpdf": "^1.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@onmyway133/nod": "1.0.6",
    "@storybook/react-vite": "^10.5.5",
    "@storybook/tanstack-react": "^10.5.5",
    "@tanstack/devtools-vite": "^0.8.1",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.167.46",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/marked": "^6.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.12.1",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.8.1",
    "storybook": "^10.5.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "vite": "^8.1.6",
    "vitest": "^4.1.12",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
