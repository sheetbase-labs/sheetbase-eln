{
  "id": "/",
  "name": "Sheetbase",
  "short_name": "Sheetbase",
  "description": "Precise, flexible electronic lab notebook",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fdfdff",
  "theme_color": "#fdfdff",
  "user_preferences": {
    "color_scheme": {
      "dark": { "background_color": "#111111", "theme_color": "#111111" }
    }
  },
  "categories": ["productivity", "science"],
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Scan a label",
      "short_name": "Scan",
      "description": "Read a sample, material or instrument label with the camera",
      "url": "/scan",
      "icons": [
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "New experiment",
      "short_name": "New experiment",
      "description": "Start a new experiment",
      "url": "/experiments/new",
      "icons": [
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "Today's bookings",
      "short_name": "Bookings",
      "description": "See what is booked on the instruments today",
      "url": "/schedule",
      "icons": [
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "text/csv",
            "text/plain",
            "application/json",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            "application/vnd.ms-excel",
            "application/msword"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/share-target",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/tiff": [".tif", ".tiff"],
        "application/pdf": [".pdf"],
        "text/csv": [".csv"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ]
      }
    }
  ],
  "launch_handler": { "client_mode": "navigate-existing" }
}
