{
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "packages/table-eln/src/**/*.ts",
    "packages/table-eln/src/**/*.tsx",
    "perf/**/*.ts",
    "tests/unit/**/*.ts",
    "eslint.config.js",
    "prettier.config.js",
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts"
  ],

  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "sheetbase-table/dev": ["../sheetbase-table/src/index.ts"],
      "@sheetbase/table-eln": ["./packages/table-eln/src/index.ts"],
      "sheetbase-table/dev/styles.css": ["../sheetbase-table/src/ui/styles.css"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
